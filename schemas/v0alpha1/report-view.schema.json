{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/serevy/agent-kpt/main/schemas/v0alpha1/report-view.schema.json",
  "title": "agent-kpt concise report view v0alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "period",
    "locale",
    "headline",
    "summary",
    "kpis",
    "keep",
    "problems",
    "next_try",
    "trends",
    "environment_markers",
    "details"
  ],
  "properties": {
    "schema_version": {
      "const": "agent-kpt.report/v0alpha1"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "start",
        "end",
        "timezone"
      ],
      "properties": {
        "kind": {
          "enum": [
            "weekly",
            "monthly"
          ]
        },
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "locale": {
      "type": "string",
      "minLength": 2
    },
    "headline": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "kpis": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/kpi"
      }
    },
    "keep": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "problems": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "next_try": {
      "anyOf": [
        {
          "$ref": "#/$defs/card"
        },
        {
          "type": "null"
        }
      ]
    },
    "trends": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/trend"
      }
    },
    "environment_markers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/environment_marker"
      }
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metrics",
        "evidence",
        "diagnostics"
      ],
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    }
  },
  "$defs": {
    "kpi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "hint": {
          "type": "string"
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "body",
        "evidence_ids"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "badge": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "trend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "direction",
        "body"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "up",
            "down",
            "flat",
            "new"
          ]
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environment_marker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "previous",
        "current",
        "body"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "previous": {
          "type": "string",
          "minLength": 1
        },
        "current": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "raw_occurrences",
        "unique_sessions",
        "unique_root_lineages",
        "distinct_days",
        "distinct_weeks"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "plain_note": {
          "type": "string"
        },
        "raw_occurrences": {
          "type": "integer",
          "minimum": 0
        },
        "unique_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "unique_root_lineages": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_days": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_weeks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "observed_at",
        "root_lineage_id",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "root_lineage_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "history_role": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "subtype": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "recoverable": {
          "type": "boolean"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
