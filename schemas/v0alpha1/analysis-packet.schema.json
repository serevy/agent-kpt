{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/serevy/agent-kpt/main/schemas/v0alpha1/analysis-packet.schema.json",
  "title": "agent-kpt privacy-safe analysis packet v0alpha1",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "generated_at",
    "period",
    "project",
    "metrics",
    "signals",
    "environment",
    "environment_changes",
    "ledger",
    "evidence",
    "diagnostics",
    "report_contract",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "const": "agent-kpt.analysis/v0alpha1"
    },
    "mode": {
      "enum": [
        "weekly",
        "monthly"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "period": {
      "type": "object"
    },
    "project": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "signals": {
      "type": "object"
    },
    "environment": {
      "type": "object"
    },
    "environment_changes": {
      "type": "array"
    },
    "ledger": {
      "type": "object"
    },
    "evidence": {
      "type": "array"
    },
    "diagnostics": {
      "type": "array"
    },
    "report_contract": {
      "type": "object",
      "description": "New packets include resolved report language and selection provenance. Fields remain optional so older saved v0alpha1 packets can still be read.",
      "properties": {
        "locale": {
          "type": "string",
          "minLength": 2,
          "description": "Resolved language tag: --locale > AGENT_KPT_LOCALE > --conversation-locale > en-US."
        },
        "locale_source": {
          "enum": ["explicit", "environment", "conversation", "default"]
        }
      }
    },
    "privacy": {
      "type": "object",
      "required": [
        "raw_prompt_text_persisted",
        "raw_assistant_text_persisted",
        "raw_tool_input_persisted",
        "raw_error_text_persisted",
        "derived_error_classification_retained"
      ],
      "properties": {
        "raw_prompt_text_persisted": {
          "const": false
        },
        "raw_assistant_text_persisted": {
          "const": false
        },
        "raw_tool_input_persisted": {
          "const": false
        },
        "raw_error_text_persisted": {
          "const": false
        },
        "derived_error_classification_retained": {
          "const": true
        }
      }
    }
  }
}
