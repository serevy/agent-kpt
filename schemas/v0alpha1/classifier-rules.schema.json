{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/serevy/agent-kpt/main/schemas/v0alpha1/classifier-rules.schema.json",
  "title": "agent-kpt local classifier rules v0alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ruleset_version", "rules"],
  "properties": {
    "schema_version": {"const": "agent-kpt.classifier-rules/v0alpha1"},
    "ruleset_version": {"type": "string", "minLength": 1},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contains_any", "category", "subtype", "outcome"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "tool": {"type": "string", "minLength": 1},
          "contains_any": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {"type": "string", "minLength": 1}
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "subtype": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "outcome": {
            "enum": ["failure", "blocked", "waiting", "warning", "transient", "unknown"]
          }
        }
      }
    }
  }
}
